{
	"geode": "5.3.0",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "grindingharders.buttplug-mod",
	"name": "Geometry Butt",
	"version": "v1.0.0",
	"developer": "GrindingHarders",
	"description": "geometry dash buttplug.io support",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Enabled",
			"description": "Enable or disable all vibration.",
			"default": true
		},

		"intensity": {
			"type": "int",
			"name": "Intensity",
			"description": "Vibration intensity for normal events.",
			"default": 100,
			"min": 0,
			"max": 100
		},

		"duration": {
			"type": "int",
			"name": "Duration",
			"description": "Vibration duration in milliseconds.",
			"default": 250,
			"min": 1,
			"max": 5000
		},

		"on-death": {
			"type": "bool",
			"name": "When player dies",
			"description": "Vibrate when the player dies.",
			"default": true
		},

		"on-level-start": {
			"type": "bool",
			"name": "When level starts",
			"description": "Vibrate when a level begins, or is restarted.",
			"default": false
		},

		"on-level-complete": {
			"type": "bool",
			"name": "When level completes",
			"description": "Vibrate when the level is completed.",
			"default": false
		},

		"on-new-best": {
			"type": "bool",
			"name": "When getting a new best",
			"description": "Vibrate when a new personal best is reached.",
			"default": false
		},

		"progressive-rumble": {
			"type": "bool",
			"name": "Progressive rumble",
			"description": "Increase vibration intensity according to level progress (Ex 25% = 25% intensity, 50% = 50% intensity, etc...).",
			"default": false
		},

		"progressive-min": {
			"type": "int",
			"name": "Progressive minimum intensity",
			"description": "Vibration intensity at 0% progress.",
			"default": 0,
			"min": 0,
			"max": 100
		},

		"progressive-max": {
			"type": "int",
			"name": "Progressive maximum intensity",
			"description": "Vibration intensity at 100% progress.",
			"default": 100,
			"min": 0,
			"max": 100
		},

		"on-jump": {
			"type": "bool",
			"name": "When jump button is pressed",
			"description": "Vibrate whenever the player presses the jump button.",
			"default": false
		}
	}
}
